# In-cluster E2E runner: runs Spark example notebooks inside the cluster so
# SparkClient uses the in-cluster URL (sc://...svc.cluster.local) and no port-forward.
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY kubeflow/ kubeflow/
COPY examples/ examples/

RUN pip install --no-cache-dir .[spark] "papermill>=2.6.0" "ipykernel>=6.29.5" && \
    python -m ipykernel install --name python3 --user && \
    mkdir -p /output

ENV SPARK_TEST_NAMESPACE=spark-test
ENV PYTHONUNBUFFERED=1

# Default command can be overridden by Job args
CMD ["papermill", "examples/spark/spark_connect_simple.ipynb", "/output/spark_connect_simple.ipynb", "--log-output"]
